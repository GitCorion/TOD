# Copiar a .env y ajustar. No versionar .env.
PUID=1000
PGID=1000
TZ=Etc/UTC

# IP LAN y/o WireGuard desde la que se abre la web.
# Añade la IP del servidor o el acceso por IP será rechazado.
# El nombre interno `tod` lo añade docker-compose.yml para Jellyfin.
TOD_WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional: protege la web con token.
# TOD_WEB_TOKEN=

# qBittorrent: usuario de la Web UI. La contraseña inicial aparece en
# `docker compose logs qbittorrent`; cámbiala en su interfaz y pégala aquí
# o en TOD → Configuración.
QBIT_USER=admin
# QBIT_PASS=

# Claves que se pueden rellenar aquí o en TOD → Configuración.
# PROWLARR_API_KEY=
# JACKETT_API_KEY=
# JELLYFIN_API_KEY=
# TMDB_API_KEY=

# Opcional: raíces distintas de Radarr y Sonarr. Si no se indican, se usa
# TOD_LIBRARY_ROOT (montado en /library por docker-compose.yml).
# TOD_LIBRARY_ROOT_MOVIES=/media/movies
# TOD_LIBRARY_ROOT_SERIES=/media/tv
