[Unit]
Description=TOD — Torrent on Demand (web + reproducción + scheduler)
Documentation=file://@ROOT@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/catalogo.env
ExecStart=/usr/bin/python3 -m catalogo.cli service --host @HOST@ --port @PORT@
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@ROOT@/var -/mnt/catalogo -/mnt/library -/mnt/descargas -/mnt/cache

[Install]
WantedBy=multi-user.target
