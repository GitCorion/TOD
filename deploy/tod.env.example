# TOD — Torrent on Demand
# Copiar a /etc/tod.env con permisos 640 root:tu_grupo.
# Este fichero es solo el arranque/fallback: la configuración normal se
# gestiona desde la web, en Configuración, y se guarda en var/tod.db.
QBIT_URL=http://127.0.0.1:8080
QBIT_USER=qbittorrent
QBIT_PASS=cambiar

# Panel web y reproducción unificados. Por defecto: 0.0.0.0:8773.
# TOD_WEB_TOKEN=
# Hosts permitidos (IP LAN e IP de WireGuard), separados por coma.
# TOD_WEB_ALLOWED_HOSTS=IP_LAN,IP_WIREGUARD
# TOD_PLAYBACK_BASE_URL=http://127.0.0.1:8773

# Directorios (también editables desde la web).
# TOD_CATALOG_LIBRARY=/mnt/catalogo
# TOD_LIBRARY_ROOT=/mnt/library
# TOD_DOWNLOADS_ROOT=/mnt/descargas
# TOD_ONDEMAND_SAVE=/mnt/descargas/ondemand
# TOD_STRM_ROOTS=/mnt/catalogo:/mnt/library

# Integraciones (lo normal es configurarlas en la web, no aquí).
# PROWLARR_URL=http://127.0.0.1:9696/api/v1
# PROWLARR_API_KEY=
# JACKETT_URL=http://127.0.0.1:9117/api/v2.0
# JACKETT_API_KEY=
# JELLYFIN_URL=http://127.0.0.1:8096
# JELLYFIN_API_KEY=
# TMDB_API_KEY=

# Avanzado: Real-Debrid solo para releases públicos. No es necesario.
# RD_API_KEY=
